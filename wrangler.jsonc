{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Top level = production Worker "maxx-sales-training" (training.maxxorthoportal.com).
  // `--env dev` = Worker "maxx-sales-training-dev" (training-dev.maxxorthoportal.com).
  // Each environment gets its own Supabase project via build variables in Cloudflare.
  "name": "maxx-sales-training",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Only serve on the custom domains (protected by Cloudflare Access), not on
  // *.workers.dev or per-version preview URLs, which would bypass Access.
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "maxx-sales-training" }
  ],
  "routes": [
    { "pattern": "training.maxxorthoportal.com", "custom_domain": true }
  ],
  "env": {
    "dev": {
      "workers_dev": false,
      "preview_urls": false,
      "services": [
        { "binding": "WORKER_SELF_REFERENCE", "service": "maxx-sales-training-dev" }
      ],
      "routes": [
        { "pattern": "training-dev.maxxorthoportal.com", "custom_domain": true }
      ]
    }
  }
}
