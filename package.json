{
  "name": "rep-training-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test",
    "check": "npm run lint && npm run test && npm run build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "deploy:dev": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env dev",
    "upload:dev": "opennextjs-cloudflare build && opennextjs-cloudflare upload --env dev",
    "test:db": "node --test supabase/tests/access-rules.mjs",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.10",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.117.3",
    "next": "16.3.8",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "pg": "^8.13.1",
    "wrangler": "^4.149.0"
  }
}
