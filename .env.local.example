NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Shows a red "LOCAL environment" banner. Leave unset only for production builds.
NEXT_PUBLIC_APP_ENV=local
OPENROUTER_API_KEY=your-openrouter-api-key
# Optional. Defaults shown below.
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_PDF_ENGINE=cloudflare-ai

# Only for scripts, never for the app. Keep them out of NEXT_PUBLIC_* and out of the Worker.
# Postgres connection string for `npm run test:db` (Supabase → Project Settings → Database).
# SUPABASE_DB_URL=postgresql://postgres:password@db.YOUR-PROJECT.supabase.co:5432/postgres
# Service-role key for scripts/wp-import/load.mjs (bypasses row-level security).
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
